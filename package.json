{
	"name": "@overworks/n8n-nodes-booru",
	"version": "0.1.0",
	"description": "n8n community nodes for Danbooru and compatible image boards",
	"license": "MIT",
	"homepage": "https://github.com/overworks/n8n-nodes-booru#readme",
	"author": {
		"name": "Minhyung Park",
		"email": "urlinee@gmail.com",
		"url": "https://github.com/overworks"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/overworks/n8n-nodes-booru.git"
	},
	"bugs": {
		"url": "https://github.com/overworks/n8n-nodes-booru/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"danbooru",
		"booru"
	],
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.16.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier --write .",
		"test": "npm run build && node --test tests/*.test.cjs",
		"check": "npm run lint && npm test",
		"release": "n8n-node release",
		"prepublishOnly": "npm run check"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BooruApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Booru/Booru.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.2",
		"@types/node": "^22.0.0",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "^21.1.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
